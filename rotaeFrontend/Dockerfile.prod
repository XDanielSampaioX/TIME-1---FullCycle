# --- ETAPA 1: Instalação de dependências limpas ---
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

# --- ETAPA 2: Build do Next.js ---
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# --- ETAPA 3: Imagem final leve para execução ---
FROM node:20-alpine AS runner
WORKDIR /app

# O Next.js standalone precisa da pasta public e dos arquivos estáticos
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

EXPOSE 3000

# O modo standalone gera o 'server.js' para rodar com Node puro em produção
CMD ["node", "server.js"]
